# Supabase Data API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres URI — required for setup_schema.py to run CREATE TABLE
# Supabase → Project Settings → Database → Connection string → URI (direct, port 5432)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
# Alternative: script builds the direct URI from SUPABASE_URL + this password
SUPABASE_DB_PASSWORD=your-database-password
# Fallback if you do not set either: paste schema.sql into the Supabase SQL Editor

# Apify residential crawl
APIFY_TOKEN=apify_api_your_token
APIFY_ACTOR_ID=apify/website-content-crawler
SCRAPE_MAX_PAGES=12
# SCRAPE_SIGNAL_KINDS=tender,expansion,filing
# SCRAPE_START_URLS=https://example.com/tenders,https://example.com/suppliers

# LLM enrichment + outreach (set one provider)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# LLM_MODEL=gpt-4o-mini

MATCH_SCORE_THRESHOLD=60

# Operations desk (local default http://127.0.0.1:8765)
# HOST=0.0.0.0
# PORT=8765
# DASHBOARD_USER=meridian
# DASHBOARD_PASSWORD=
# Public URL used in password-reset emails and Stripe return links
# APP_BASE_URL=http://127.0.0.1:8765

# Email / password logins (created on first dashboard start or setup_database.py --seed)
# OPERATOR_EMAIL=ops@example.com
# OPERATOR_PASSWORD=change-me-now-1
# PORTAL_DEFAULT_PASSWORD=change-me-now-1
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_STARTTLS=1

# Hidden retainer checkout — do not add this path to public navigation
# Share only as https://your-host/pay/retainer/<RETAINER_ACCESS_TOKEN>
# POST https://your-host/api/pay/stripe/webhook
#   checkout.session.completed, checkout.session.async_payment_succeeded,
#   checkout.session.async_payment_failed, payment_intent.succeeded,
#   payment_intent.payment_failed, invoice.paid, invoice.payment_failed,
#   customer.subscription.updated, customer.subscription.deleted, mandate.updated
# Prefer a restricted key (rk_live_ / rk_test_) over a secret key.
# Create a recurring £4,000 GBP Price in Stripe and set its lookup key.
# STRIPE_LOOKUP_KEY=retainer_monthly
# STRIPE_RETAINER_PRICE_ID=price_...
# STRIPE_PAYMENT_METHOD_CONFIGURATION=pmc_...
# RETAINER_ACCESS_TOKEN=
# RETAINER_AMOUNT_PENCE=400000
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Scheduled pipeline (run_scheduled_pipeline.py / GitHub Actions / Render cron)
# PIPELINE_MOCK=1
# PIPELINE_SKIP_SCRAPE=0
# PIPELINE_FIXTURE=0
# PIPELINE_FORCE_OUTREACH=0
# PIPELINE_RUN_SETUP=0
# PIPELINE_INTERVAL_HOURS=0
# LLM_MODEL=gpt-4o-mini

